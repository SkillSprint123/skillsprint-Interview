{
  "name": "skillsprint-interview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vp dev",
    "check": "vp check --deny-warnings && npm run typecheck && npm run lint:vue",
    "typecheck": "vue-tsc -b",
    "lint": "vp lint --deny-warnings && npm run lint:vue",
    "lint:vue": "eslint \"src/**/*.vue\" --max-warnings 0",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "build": "npm run build:prod",
    "build:prod": "npm run typecheck && vp build --mode brojs",
    "build:brojs": "npm run build:prod",
    "build:nano": "npm run typecheck && vp build",
    "build:demo": "npm run typecheck && vp build --mode demo",
    "preview": "vp preview --outDir dist-demo",
    "verify": "npm run check && npm run test:coverage && npm run build:prod && node scripts/check-brojs-build.mjs && npm run build:nano && npm run build:demo"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "@skillsprint/contracts": "file:vendor/skillsprint-contracts-1.0.0.tgz",
    "goober": "2.1.19",
    "pinia": "^2.1.3",
    "vue": "^3.5.42",
    "vue-router": "^4.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@11.20.0"
}
