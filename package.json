{
  "name": "skillsprint-interview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vp dev",
    "check": "vp check --deny-warnings && npm run typecheck && npm run lint:vue && npm run test:coverage",
    "typecheck": "vue-tsc -b",
    "lint": "vp lint --deny-warnings && npm run lint:vue",
    "lint:vue": "eslint \"src/**/*.vue\" --max-warnings 0",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "build": "npm run build:prod",
    "build:prod": "npm run typecheck && vp build && node scripts/convert-to-systemjs.mjs",
    "preview": "vp preview --port 5173 --strictPort",
    "verify": "npm run check && npm run build:prod && node scripts/check-module-build.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "@skillsprint/contracts": "file:vendor/skillsprint-contracts-1.0.0.tgz",
    "goober": "2.1.19",
    "http-status-codes": "^2.3.0",
    "pinia": "^2.1.3",
    "vue": "^3.5.42",
    "vue-router": "^4.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@jest/globals": "30.5.2",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/tsconfig": "^0.9.1",
    "babel-jest": "30.5.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jsdom": "^30.1.3",
    "systemjs": "6.15.1",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@11.20.0"
}
